# Source and artifact paths are relative to the project root unless absolute.
PDF_DIR=data/raw
WEB_DIR=data/raw/web
PROCESSED_DIR=data/processed
INDEX_DIR=indexes
RESULTS_DIR=results
EXCLUDED_DOCUMENTS=
MAX_PDF_UPLOAD_MB=50

# OCR thresholds control image rendering and index eligibility; confidence is
# only one signal and does not by itself establish transcription accuracy.
OCR_RENDER_SCALE=2.0
OCR_MIN_CONFIDENCE=0.9
OCR_MIN_VALID_CHARACTER_RATIO=0.8
OCR_MIN_TEXT_CHARACTERS=20
OCR_MIN_TEXT_QUALITY_SCORE=0.65
OCR_HYBRID_IMAGE_AREA_RATIO=0.15

# Chunking and retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=120
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
BM25_TOP_K=8
FAISS_TOP_K=8
RRF_K=60
FINAL_TOP_K=5
TOKEN_BUDGET=3000
EVALUATION_MIN_VERIFIED_QUESTIONS=15

# Optional OpenAI-compatible chat-completions endpoint. No key is required for
# ingestion, indexing, retrieval evaluation, or the portal's retrieval display.
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_REASONING_EFFORT=low
# LLM_TIMEOUT=180

# Groq uses its OpenAI-compatible API. Set LLM_API_KEY to your Groq API key.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT=180
